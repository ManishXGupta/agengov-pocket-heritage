{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ManishXGupta/agengov-pocket-heritage/schema/passport.schema.json",
  "title": "Heritage Digital Passport",
  "description": "Governed record for one heritage object: identity, provenance, attributed interpretation strands, approved sources, access conditions, and sensitivity. See Sections III and IV of the AGenGov Pocket Heritage paper.",
  "type": "object",
  "required": ["object_id", "passport_version", "synthetic", "identity", "sources", "strands", "curator_approval", "sensitivity"],
  "additionalProperties": false,
  "properties": {
    "object_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "passport_version": {"type": "integer", "minimum": 1},
    "synthetic": {"type": "boolean", "description": "True for invented example data. All passports in this repository are synthetic."},
    "identity": {
      "type": "object",
      "required": ["name", "category", "site"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "category": {"type": "string"},
        "site": {"type": "string"},
        "reference_images": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acquisition": {"type": "string"},
        "chain": {"type": "array", "items": {"type": "string"}},
        "prov_o_uri": {"type": "string"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "strands": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/strand"}
    },
    "contested": {"type": "boolean", "default": false},
    "consensus_strand": {"type": ["string", "null"], "description": "Set only when the stewardship board has recorded a consensus."},
    "sensitivity": {
      "type": "object",
      "required": ["cultural"],
      "additionalProperties": false,
      "properties": {
        "cultural": {"enum": ["none", "low", "medium", "high", "sacred"]},
        "tk_labels": {"type": "array", "items": {"type": "string"}, "description": "Local Contexts Traditional Knowledge labels."},
        "restricted_location": {"type": "boolean", "default": false},
        "personal_data": {"type": "boolean", "default": false}
      }
    },
    "curator_approval": {
      "type": "object",
      "required": ["approved", "reviewed_on", "approver_role"],
      "additionalProperties": false,
      "properties": {
        "approved": {"type": "boolean"},
        "reviewed_on": {"type": "string", "format": "date"},
        "approver_role": {"type": "string"}
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "study_card": {"type": "string"},
        "quiz": {"type": "array", "items": {"type": "object", "required": ["q", "a"], "properties": {"q": {"type": "string"}, "a": {"type": "string"}}}}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["source_id", "title", "authority", "approval"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string"},
        "title": {"type": "string"},
        "authority": {"type": "number", "minimum": 0, "maximum": 1},
        "approval": {
          "type": "object",
          "description": "Stewardship-board approval with the five admission criteria of Section III.B.",
          "required": ["status", "approver_roles", "criteria", "reviewed_on"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["approved", "pending", "withdrawn"]},
            "approver_roles": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "reviewed_on": {"type": "string", "format": "date"},
            "criteria": {
              "type": "object",
              "required": ["traceable_provenance", "scholarly_or_institutional_standing", "community_consent", "review_date_recorded", "conflict_of_interest_checked"],
              "additionalProperties": false,
              "properties": {
                "traceable_provenance": {"type": "boolean"},
                "scholarly_or_institutional_standing": {"type": "boolean"},
                "community_consent": {"type": "boolean"},
                "review_date_recorded": {"type": "boolean"},
                "conflict_of_interest_checked": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "text", "source_ids", "access"],
      "additionalProperties": false,
      "properties": {
        "claim_id": {"type": "string"},
        "topic": {"enum": ["identity", "history", "provenance", "location", "meaning", "practice"]},
        "text": {"type": "string"},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "access": {"enum": ["public", "education", "internal", "restricted-community"]}
      }
    },
    "strand": {
      "type": "object",
      "required": ["strand_id", "perspective", "attribution", "claims"],
      "additionalProperties": false,
      "properties": {
        "strand_id": {"type": "string"},
        "perspective": {"enum": ["museum record", "community account", "academic debate", "disputed"]},
        "attribution": {"type": "string"},
        "restricted_by_community": {"type": "boolean", "default": false},
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}}
      }
    }
  }
}
